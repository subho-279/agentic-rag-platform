# Copy to .env to override defaults. Everything works without it.

# --- LLM / embeddings -------------------------------------------------------
# LLM_PROVIDER: extractive (default, offline) | ollama | openai | anthropic
LLM_PROVIDER=extractive
# EMBEDDING_PROVIDER: hash (default, offline, lexical) | openai
EMBEDDING_PROVIDER=hash

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Secrets (dev defaults; change for anything beyond a laptop) ------------
JWT_SECRET=dev-only-jwt-secret-at-least-32-bytes-long!!
INTERNAL_TOKEN=dev-internal-token-change-me
# Exposes GET /dev/token so the demo can mint JWTs. Turn OFF outside local demos.
DEV_TOKENS_ENABLED=true

# --- Rate limiting (per tenant token bucket) --------------------------------
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=5
