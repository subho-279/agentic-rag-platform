# Copy to .env.prod and fill in. NEVER commit .env.prod.
# Generate each secret with:  openssl rand -hex 32
# Passwords go into connection URLs, so keep them URL-safe (hex is).

DOMAIN=rag.example.com

POSTGRES_PASSWORD=
RAG_APP_PASSWORD=
REDIS_PASSWORD=
INTERNAL_TOKEN=

# Authentication: choose ONE.
# (a) Your OIDC provider (Keycloak, Auth0, Entra ID, ...). Tokens must carry a `tenant_id` claim and a `roles` array.
OIDC_ISSUER_URI=
# (b) Self-managed HS256 tokens, minted by scripts/mint_token.py with this secret (>= 32 bytes).
JWT_SECRET=

# Model providers. Defaults run fully offline (lexical embeddings + extractive answers).
LLM_PROVIDER=extractive
EMBEDDING_PROVIDER=hash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SEC=10
